--- a/execution/pkg/utils/watchdog.go
+++ b/execution/pkg/utils/watchdog.go
@@ -1,11 +1,30 @@
 package utils
 
 import (
+	"fmt"
+	"os"
+	"runtime"
+	"sync/atomic"
 	"time"
 
 	"github.com/meta-node-blockchain/meta-node/pkg/logger"
 )
 
+var watchdogDumped atomic.Bool
+
+// dumpGoroutinesOnce writes all goroutine stacks to a file (once per process) so a hang can be diagnosed post-mortem.
+func dumpGoroutinesOnce(name string) {
+	if !watchdogDumped.CompareAndSwap(false, true) {
+		return
+	}
+	buf := make([]byte, 64<<20)
+	n := runtime.Stack(buf, true)
+	path := fmt.Sprintf("/tmp/watchdog_goroutines_%s_%d_%d.txt", name, os.Getpid(), time.Now().Unix())
+	if err := os.WriteFile(path, buf[:n], 0o644); err == nil {
+		logger.Warn("🆘 [WATCHDOG-%s] goroutine dump written to %s (%d bytes)", name, path, n)
+	}
+}
+
 // StartWatchdog starts a background goroutine that prints a warning if it takes longer than the timeout.
 // getContext is called every time the timer fires to get the latest status.
 // It returns a Stop function that MUST be called when the tracked process finishes.
@@ -20,6 +39,9 @@ func StartWatchdog(name string, timeout time.Duration, getContext func() string)
