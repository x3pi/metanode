index 00000000..3cb235cb
--- /dev/null
+++ b/consensus/vendor/nomt/nomt/src/diag.rs
@@ -0,0 +1,226 @@
+#![allow(missing_docs)]
+
+use std::fs;
+use std::io::Write;
+use std::sync::atomic::{AtomicBool, AtomicU64, Ordering};
+use std::sync::Once;
+use std::time::{Duration, SystemTime, UNIX_EPOCH};
+
+// Atomic counters for write_ht (Part a)
+pub static WRITE_HT_ACTIVE: AtomicBool = AtomicBool::new(false);
+pub static WRITE_HT_START_TS: AtomicU64 = AtomicU64::new(0);
+pub static WRITE_HT_EXPECTED: AtomicU64 = AtomicU64::new(0);
+pub static WRITE_HT_SENT: AtomicU64 = AtomicU64::new(0);
+pub static WRITE_HT_RECV: AtomicU64 = AtomicU64::new(0);
+pub static WRITE_HT_ERR: AtomicU64 = AtomicU64::new(0);
+
+// Atomic counters for io-worker (Part b)
+pub static IO_PACKETS_RECEIVED: AtomicU64 = AtomicU64::new(0);
+pub static IO_SQES_PUSHED: AtomicU64 = AtomicU64::new(0);
+pub static IO_CQES_REAPED: AtomicU64 = AtomicU64::new(0);
+pub static IO_COMPLETIONS_SENT_OK: AtomicU64 = AtomicU64::new(0);
+pub static IO_COMPLETIONS_SENT_ERR: AtomicU64 = AtomicU64::new(0);
+pub static IO_RETRIES_PUSHED: AtomicU64 = AtomicU64::new(0);
+
+// Atomic counters for IoHandle (Part c)
+pub static IO_UPGRADE_FAILED: AtomicU64 = AtomicU64::new(0);
+pub static IO_SEND_ERR: AtomicU64 = AtomicU64::new(0);
+
+#[inline]
+pub fn inc_packets_received() {
+    IO_PACKETS_RECEIVED.fetch_add(1, Ordering::Relaxed);
+}
+
+#[inline]
+pub fn inc_sqes_pushed() {
+    IO_SQES_PUSHED.fetch_add(1, Ordering::Relaxed);
+}
+
+#[inline]
+pub fn inc_cqes_reaped() {
+    IO_CQES_REAPED.fetch_add(1, Ordering::Relaxed);
+}
+
+#[inline]
+pub fn inc_completions_sent_ok() {
+    IO_COMPLETIONS_SENT_OK.fetch_add(1, Ordering::Relaxed);
+}
+
+#[inline]
+pub fn inc_completions_sent_err() {
+    IO_COMPLETIONS_SENT_ERR.fetch_add(1, Ordering::Relaxed);
+}
+
+#[inline]
+pub fn inc_retries_pushed() {
+    IO_RETRIES_PUSHED.fetch_add(1, Ordering::Relaxed);
+}
+
+#[inline]
+pub fn inc_upgrade_failed() {
+    IO_UPGRADE_FAILED.fetch_add(1, Ordering::Relaxed);
+}
+
+#[inline]
+pub fn inc_send_err() {
+    IO_SEND_ERR.fetch_add(1, Ordering::Relaxed);
+}
+
+pub fn on_write_ht_start(expected: u64) {
+    ensure_hang_monitor_started();
+    let now_ms = SystemTime::now()
+        .duration_since(UNIX_EPOCH)
+        .map(|d| d.as_millis() as u64)
+        .unwrap_or(0);
+    WRITE_HT_START_TS.store(now_ms, Ordering::SeqCst);
+    WRITE_HT_EXPECTED.store(expected, Ordering::SeqCst);
+    WRITE_HT_SENT.store(0, Ordering::SeqCst);
+    WRITE_HT_RECV.store(0, Ordering::SeqCst);
+    WRITE_HT_ERR.store(0, Ordering::SeqCst);
+    WRITE_HT_ACTIVE.store(true, Ordering::SeqCst);
+}
+
+#[inline]
+pub fn on_write_ht_sent_one() {
+    WRITE_HT_SENT.fetch_add(1, Ordering::Relaxed);
+}
+
+#[inline]
+pub fn on_write_ht_recv_one(is_err: bool) {
+    WRITE_HT_RECV.fetch_add(1, Ordering::Relaxed);
+    if is_err {
+        WRITE_HT_ERR.fetch_add(1, Ordering::Relaxed);
+    }
+}
+
+pub fn on_write_ht_done() {
+    WRITE_HT_ACTIVE.store(false, Ordering::SeqCst);
+}
+
+static MONITOR_INIT: Once = Once::new();
+
+pub fn ensure_hang_monitor_started() {
+    MONITOR_INIT.call_once(|| {
+        eprintln!("[NOMT_DIAG_BUILD_VERIFIED] NOMT Advanced Hang Diagnostics initialized with atomic counters and monitor thread.");
+        std::thread::Builder::new()
+            .name("nomt-diag-hang-mon".to_string())
+            .spawn(hang_monitor_loop)
+            .expect("failed to spawn nomt hang monitor thread");
+    });
+}
+
+fn hang_monitor_loop() {
+    let mut last_warned_elapsed = 0u64;
+    loop {
+        std::thread::sleep(Duration::from_millis(5000));
+        if !WRITE_HT_ACTIVE.load(Ordering::SeqCst) {
+            last_warned_elapsed = 0;
+            continue;
+        }
+
+        let start_ms = WRITE_HT_START_TS.load(Ordering::SeqCst);
+        let now_ms = SystemTime::now()
+            .duration_since(UNIX_EPOCH)
+            .map(|d| d.as_millis() as u64)
+            .unwrap_or(0);
+
+        if now_ms < start_ms {
+            continue;
+        }
+        let elapsed_secs = (now_ms - start_ms) / 1000;
+
+        if elapsed_secs >= 30 && (elapsed_secs - last_warned_elapsed >= 30) {
+            last_warned_elapsed = elapsed_secs;
+
+            let sent = WRITE_HT_SENT.load(Ordering::Relaxed);
+            let recv = WRITE_HT_RECV.load(Ordering::Relaxed);
+            let errs = WRITE_HT_ERR.load(Ordering::Relaxed);
+            let expected = WRITE_HT_EXPECTED.load(Ordering::Relaxed);
+
+            let pkts_rcv = IO_PACKETS_RECEIVED.load(Ordering::Relaxed);
+            let sqes = IO_SQES_PUSHED.load(Ordering::Relaxed);
+            let cqes = IO_CQES_REAPED.load(Ordering::Relaxed);
+            let comp_ok = IO_COMPLETIONS_SENT_OK.load(Ordering::Relaxed);
+            let comp_err = IO_COMPLETIONS_SENT_ERR.load(Ordering::Relaxed);
+            let retries = IO_RETRIES_PUSHED.load(Ordering::Relaxed);
+            let upg_fail = IO_UPGRADE_FAILED.load(Ordering::Relaxed);
+            let snd_err = IO_SEND_ERR.load(Ordering::Relaxed);
+
+            eprintln!(
+                "[DIAG_HANG_MONITOR] !!! POTENTIAL WRITE_HT HANG DETECTED !!!\n\
+                 Elapsed: {}s, write_ht expected={}, sent={}, received={}, err={}\n\
+                 [DIAG_HANG_MONITOR] Global IO stats: packets_received={}, sqes_pushed={}, cqes_reaped={}, completions_sent_ok={}, completions_sent_err={}, retries_pushed={}, upgrade_failed={}, send_err={}",
+                elapsed_secs, expected, sent, recv, errs,
+                pkts_rcv, sqes, cqes, comp_ok, comp_err, retries, upg_fail, snd_err
+            );
+
+            dump_tasks_and_backtrace(elapsed_secs, sent, recv, pkts_rcv, sqes, cqes, comp_ok, comp_err);
+        }
+    }
+}
+
+fn dump_tasks_and_backtrace(
+    elapsed_secs: u64,
+    sent: u64,
+    recv: u64,
+    pkts_rcv: u64,
+    sqes: u64,
+    cqes: u64,
+    comp_ok: u64,
+    comp_err: u64,
+) {
+    let pid = std::process::id();
+    let mut dump_lines = Vec::new();
+    dump_lines.push(format!(
+        "=== NOMT WRITE_HT HANG DUMP (PID {}, elapsed {}s) ===",
+        pid, elapsed_secs
+    ));
+    dump_lines.push(format!(
+        "write_ht: sent={}, received={}, diff={}",
+        sent, recv, sent.saturating_sub(recv)
+    ));
+    dump_lines.push(format!(
+        "IO worker counters: packets_rcv={}, sqes={}, cqes={}, comp_ok={}, comp_err={}",
+        pkts_rcv, sqes, cqes, comp_ok, comp_err
+    ));
+    dump_lines.push("--- /proc/self/task/*/{comm,stat,wchan} ---".to_string());
+
+    if let Ok(entries) = fs::read_dir("/proc/self/task") {
+        for entry in entries.flatten() {
+            let tid = entry.file_name().to_string_lossy().to_string();
+            let comm = fs::read_to_string(format!("/proc/self/task/{}/comm", tid))
+                .unwrap_or_default()
+                .trim()
+                .to_string();
+            let wchan = fs::read_to_string(format!("/proc/self/task/{}/wchan", tid))
+                .unwrap_or_default()
+                .trim()
+                .to_string();
+            let stat = fs::read_to_string(format!("/proc/self/task/{}/stat", tid))
+                .unwrap_or_default();
+            let state = stat.split_whitespace().nth(2).unwrap_or("?");
+
+            let line = format!("TID {:<8} comm={:<16} state={} wchan={}", tid, comm, state, wchan);
+            if comm.contains("io-worker") || comm.contains("commit") || comm.contains("simple_chain") || state == "D" {
+                eprintln!("[DIAG_HANG_MONITOR] [SUSPECT THREAD] {}", line);
+            }
+            dump_lines.push(line);
+        }
+    }
+
+    let bt = std::backtrace::Backtrace::force_capture();
+    dump_lines.push(format!("\n--- Monitor Thread Backtrace ---\n{}", bt));
+    dump_lines.push("\n[Note: In-process backtraces of arbitrary peer threads without signals/ptrace is not supported in safe Rust. Kernel wait channels (wchan) above provide the exact blocking syscall/primitive.]".to_string());
+
+    let dump_content = dump_lines.join("\n");
+    let dump_dirs = ["/tmp/gemini_verify/meas_out", "/tmp"];
+    for dir in &dump_dirs {
+        let _ = fs::create_dir_all(dir);
+        let path = format!("{}/nomt_hang_dump_{}_{}s.txt", dir, pid, elapsed_secs);
+        if let Ok(mut f) = fs::File::create(&path) {
+            let _ = f.write_all(dump_content.as_bytes());
+            eprintln!("[DIAG_HANG_MONITOR] Saved full thread state dump to {}", path);
+            break;
+        }
+    }
+}
