+// isPrecompileAddress reports whether addr is an EVM precompile (0x01..0x0a).
+func isPrecompileAddress(addr eth_common.Address) bool {
+	for i := 0; i < 19; i++ {
+		if addr[i] != 0 {
+			return false
+		}
+	}
+	return addr[19] >= 1 && addr[19] <= 10
