+		digest := ComputeAccountLockedAttestDigest(h.attestChainID(), payload.User, payload.HomeCluster, payload.ParentSeq)
+		ok, err := h.verifyAttestations(store, committee, digest, payload.Attestations)
+		if err != nil {
+			return err
+		}
+		if ok {
