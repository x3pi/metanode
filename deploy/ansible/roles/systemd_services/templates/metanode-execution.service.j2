[Unit]
Description=Metanode Execution Layer (Go) — Node {{ item }}
Documentation=https://github.com/x3pi/metanode
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=metanode
Group=metanode
WorkingDirectory={{ metanode_install_dir }}/node-{{ item }}/bin

ExecStart={{ metanode_install_dir }}/node-{{ item }}/bin/simple_chain -config={{ metanode_install_dir }}/node-{{ item }}/config/execution.json --pprof-addr=127.0.0.1:606{{ item }}
ExecStop=/bin/kill -SIGTERM $MAINPID

# Allow 90s for DB to flush cleanly on shutdown (CRITICAL — prevents DB corruption)
TimeoutStopSec=90
Restart=on-failure
RestartSec=15s

# Environment
Environment="GOTRACEBACK=crash" "SKIP_MEMPOOL_SIG_VERIFY=true"
# Default to validator, but synconly logic can be injected here based on variables
{% if item | int in synconly_nodes | default([]) or is_synconly | default(false) %}
Environment=NODE_TYPE=synconly
{% else %}
Environment=NODE_TYPE=validator
{% endif %}
# CPU co-location: {{ active_nodes | length }} node processes share this machine's cores.
# Each node's Go runtime otherwise defaults GOMAXPROCS to the FULL core count
# (see execution/cmd/simple_chain/main.go), so N co-located nodes collectively
# oversubscribe the shared cores up to Nx under load, stalling consensus round
# advancement for multiple seconds during TX bursts (measured on a 104-core /
# 5-node box: procs_running spiked to 85, ~2s round stalls). Cap per-node
# GOMAXPROCS to a fair share, leaving headroom for the sibling Rust consensus
# process and the OS. Override per-deployment via ansible var `gomaxprocs`.
Environment=GOMAXPROCS={{ gomaxprocs | default(20) }}

LimitNOFILE=100000
LimitCORE=infinity
# Logging
StandardOutput=journal
StandardError=append:{{ metanode_install_dir }}/node-{{ item }}/logs/execution/panic.log
SyslogIdentifier=metanode-execution-{{ item }}

[Install]
WantedBy=multi-user.target
