# Managed by Ansible -- do not edit by hand. Values come from (ansible-vault) variables; every entry is
# optional. See note/security_variables_reference.md section 5 for what each variable protects.
{% if snapshot_server_token | default('') | length > 0 %}
SNAPSHOT_SERVER_TOKEN="{{ snapshot_server_token }}"
{% endif %}
{% if snapshot_server_bind | default('') | length > 0 %}
SNAPSHOT_SERVER_BIND="{{ snapshot_server_bind }}"
{% endif %}
{% if quic_pinned_cert_sha256 | default('') | length > 0 %}
QUIC_PINNED_CERT_SHA256="{{ quic_pinned_cert_sha256 }}"
{% endif %}
{% if telegram_bot_token | default('') | length > 0 and 'YOUR_' not in telegram_bot_token %}
TELEGRAM_BOT_TOKEN="{{ telegram_bot_token }}"
{% endif %}
{% if (telegram_chat_id | default('') | string) | length > 0 and 'YOUR_' not in (telegram_chat_id | string) %}
TELEGRAM_CHAT_ID="{{ telegram_chat_id }}"
{% endif %}
{% if (telegram_thread_id | default('') | string) | length > 0 %}
TELEGRAM_THREAD_ID="{{ telegram_thread_id }}"
{% endif %}
{% if telegram_notify_error | default(false) | bool %}
TELEGRAM_NOTIFY_ERROR="true"
{% endif %}
