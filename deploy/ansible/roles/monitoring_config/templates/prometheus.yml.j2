global:
  scrape_interval: 5s
  evaluation_interval: 5s

rule_files:
  - "alert_rules.yml"

# 2026-09-08: this file previously referenced rule_files above with no such file anywhere in the
# repo, and no alerting: block at all -- Prometheus scraped everything but could never fire an
# alert. alert_rules.yml now ships alongside this template (roles/monitoring_config/files/), and
# points here at the local Alertmanager (role: alertmanager), which routes to the same Telegram
# bot/chat already used by monitors/start_monitors.sh.
alerting:
  alertmanagers:
    - static_configs:
        - targets: ["localhost:9093"]

scrape_configs:
  # MetaNode Go Execution Engine Metrics
  - job_name: "metanode-go-execution"
    static_configs:
      - targets: 
{% for node in cluster_nodes | sort(attribute='node_id') %}
        - "{{ node.ip }}:8757" # Node {{ node.node_id }}
{% endfor %}

  # MetaNode Rust Consensus Metrics
  - job_name: "metanode-rust-consensus"
    static_configs:
      - targets:
{% for node in cluster_nodes | sort(attribute='node_id') %}
        - "{{ node.ip }}:9100" # Node {{ node.node_id }}
{% endfor %}

  # Hardware Node Exporter Metrics
  - job_name: "node_exporter"
    static_configs:
      - targets:
{% for node in cluster_nodes | sort(attribute='node_id') %}
        - "{{ node.ip }}:9105" # Node {{ node.node_id }}
{% endfor %}
