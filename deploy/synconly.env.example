# ════════════════════════════════════════════════════════════════════
# Metanode Sync-Only (Full Node) Configuration
#
# Sync-only nodes do NOT participate in consensus.
# They sync the full chain state for use as RPC endpoints,
# block explorers, or dApp backends.
#
# Usage:
#   cp synconly.env.example synconly.env
#   nano synconly.env
#   sudo bash install.sh --config synconly.env
# ════════════════════════════════════════════════════════════════════

# ─── Node Identity ───────────────────────────────────────────────────────
NODE_TYPE=synconly

# Use a node_id higher than the validator count (e.g. if 4 validators → use 5+)
NODE_ID=5

# ─── No keys needed for sync-only ────────────────────────────────────────
# Leave PROTOCOL_KEY_FILE and NETWORK_KEY_FILE empty
PROTOCOL_KEY_FILE=
NETWORK_KEY_FILE=

# Sync-only still needs BLS key to sign outgoing MetaTxs to the network
# Generate a fresh Ethereum keypair for this — it does NOT need to be in genesis
BLS_PRIVATE_KEY=YOUR_BLS_PRIVATE_KEY_HEX
ETH_PRIVATE_KEY=YOUR_ETH_PRIVATE_KEY_HEX
ETH_ADDRESS=YOUR_ETH_ADDRESS_WITHOUT_0x

# ─── Source & Install paths ───────────────────────────────────────────────
REPO_URL=https://github.com/x3pi/metanode.git
REPO_BRANCH=main
BUILD_DIR=/opt/metanode/src
INSTALL_DIR=/opt/metanode
METANODE_USER=metanode

# ─── Genesis file ─────────────────────────────────────────────────────────
GENESIS_FILE=/path/to/genesis.json

# ─── Network Ports (use different ports if running alongside a validator) ──
RPC_PORT=:8762
P2P_PORT=4206
DNS_PORT=9081
PEER_RPC_PORT=19205
CONSENSUS_PORT=9005
SNAPSHOT_SERVER_PORT=8605
META_NODE_RPC_PORT=10105
METRICS_PORT=9105

# ─── Peers ────────────────────────────────────────────────────────────────
# Point to the validator nodes to sync from
PEER_RPC_ADDRESSES="\"VALIDATOR_0_IP:19200\", \"VALIDATOR_1_IP:19201\", \"VALIDATOR_2_IP:19202\""

# ─── Snapshot ─────────────────────────────────────────────────────────────
# Enable snapshots so other nodes can fast-sync from you
SNAPSHOT_ENABLED=true
SNAPSHOT_FREQUENCY=500
SNAPSHOT_OFFSET=100

# ─── Explorer / Archive ───────────────────────────────────────────────────
# Sync-only nodes usually serve as explorers — archive everything
IS_EXPLORER=true
EPOCHS_TO_KEEP=0
