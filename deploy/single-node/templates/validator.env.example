# ════════════════════════════════════════════════════════════════════
# Metanode Validator Node Configuration
#
# Copy this file and fill in your values:
#   cp validator.env.example validator.env
#   nano validator.env
#   sudo bash install.sh --config validator.env
# ════════════════════════════════════════════════════════════════════

# ─── Node Identity ───────────────────────────────────────────────────────
# "validator" or "synconly"
NODE_TYPE=validator

# Your node index in genesis.json validators array (0-based)
NODE_ID=0

# ─── Network Keys (Validator only) ───────────────────────────────────────
# Paths to the key files generated by: ./metanode generate -n 1 -o ./keys
PROTOCOL_KEY_FILE=/path/to/keys/node_0_protocol_key.json
NETWORK_KEY_FILE=/path/to/keys/node_0_network_key.json

# ─── Execution Layer Keys ─────────────────────────────────────────────────
# Ethereum account used by this node to sign MetaTx and blocks.
# This is the content from node_0_authority_key.json (hex, no 0x prefix)
BLS_PRIVATE_KEY=YOUR_BLS_PRIVATE_KEY_HEX

# Ethereum wallet for this node (used to sign native transactions)
ETH_PRIVATE_KEY=YOUR_ETH_PRIVATE_KEY_HEX
ETH_ADDRESS=YOUR_ETH_ADDRESS_WITHOUT_0x

# ─── Source & Install paths ───────────────────────────────────────────────
# Repository to clone and build from
REPO_URL=https://github.com/x3pi/metanode.git
REPO_BRANCH=main

# Where to clone the source code
BUILD_DIR=/opt/metanode/src

# Where to install the node (binaries, configs, data)
INSTALL_DIR=/opt/metanode

# System user to run the node under (will be created if not exists)
METANODE_USER=metanode

# ─── Genesis file ─────────────────────────────────────────────────────────
# Path to the genesis.json you received from the team
GENESIS_FILE=/path/to/genesis.json

# ─── Network Ports ────────────────────────────────────────────────────────
# JSON-RPC port (DApp / wallet connections)
RPC_PORT=:8757

# Go P2P sync port (used between nodes)
P2P_PORT=4000

# DNS helper port
DNS_PORT=7081

# Peer RPC port (consensus communication between validators)
PEER_RPC_PORT=19200

# Consensus P2P port (Rust layer)
CONSENSUS_PORT=9000

# Snapshot HTTP server port (other nodes use this to download snapshots)
SNAPSHOT_SERVER_PORT=8600

# Internal Go-Rust RPC
META_NODE_RPC_PORT=10100

# Prometheus metrics port (Rust)
METRICS_PORT=9100

# ─── Peers ────────────────────────────────────────────────────────────────
# IP:port of ALL OTHER validators (not yourself), comma-separated
# Example for a 4-validator network:
#   PEER_RPC_ADDRESSES="\"VALIDATOR_1_IP:19201\", \"VALIDATOR_2_IP:19202\", \"VALIDATOR_3_IP:19203\""
PEER_RPC_ADDRESSES="\"127.0.0.1:19201\", \"127.0.0.1:19202\", \"127.0.0.1:19203\""

# ─── Snapshot settings ────────────────────────────────────────────────────
SNAPSHOT_ENABLED=false
SNAPSHOT_FREQUENCY=500
SNAPSHOT_OFFSET=0

# ─── Explorer / Archive ───────────────────────────────────────────────────
IS_EXPLORER=false
# 0 = archive mode (keep all history), N = keep last N epochs only
EPOCHS_TO_KEEP=5
