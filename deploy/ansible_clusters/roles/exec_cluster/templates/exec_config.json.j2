{
  "debug": true,
  "cluster_id": {{ cluster_id }},
  "enable_private_gateway": false,
  "master_password": "devnet-test-password",
  "app_pepper": "devnet-test-pepper",
  "private_key": "{{ private_key }}",
  "address": "{{ address }}",
  "log_path": "{{ node_data_dir }}/logs",
  "backup_path": "{{ node_data_dir }}/backup",
  "explorer_db_path": "{{ node_data_dir }}/explorer",
  "explorer_read_only_db_path": "{{ node_data_dir }}/explorer-ro",
  "is_explorer": true,
  "connection_address": "0.0.0.0:{{ p2p_port | default(4200) }}",
  "version": "0.0.1.0",
  "rpc_port": ":{{ rpc_port }}",
  "db_type": 2,
  "genesis_file_path": "{{ node_data_dir }}/genesis.json",
  "pk_admin_file_storage": "87d931eaa2f76709f2615586e0d560ca9b80f247c9cc431e197ba3e7167db623",
  "bls_admin_storage": "2b3aa0f620d2d73c046cd93eb64f2eb687a95b22e278500aa251c8c9dda1203b",
  "owner_file_storage_address": "0xC6E6474A8DEAD25B0e75b1aeA5d35FA19f69588a",
  "Databases": {
    "RootPath": "{{ node_data_dir }}/data",
    "DBEngine": "sharded",
    "Version": "0.0.1.0",
    "BLSPrivateKey": "{{ bls_priv }}",
    "SnapshotPath": "{{ node_data_dir }}/snapshot"
  },
  "is_rpc_node": true,
  "consensus_mode": "{{ consensus_mode | default('raft') }}",
{% if (consensus_mode | default('raft')) == 'raft' %}
  "snapshot_enabled": false,
  "raft": {
    "node_id": "{{ node_id | default(raft_node_id | default(inventory_hostname)) }}",
    "bind_address": "{{ raft_bind_address | default((ansible_host | default('127.0.0.1')) ~ ':' ~ (raft_port | default(7110))) }}",
    "advertise_address": "{{ raft_advertise_address | default((ansible_host | default('127.0.0.1')) ~ ':' ~ (raft_port | default(7110))) }}",
    "data_dir": "{{ node_data_dir }}/raft",
    "bootstrap": {{ raft_bootstrap | default(false) | lower }},
    "forward_bind_address": "{{ forward_bind_address | default((ansible_host | default('127.0.0.1')) ~ ':' ~ (forward_port | default(7210))) }}",
    "forward_secret_file": "{{ raft_secret_file | default(install_dir ~ '/raft_secret.key') }}",
    "sequencer_address": "{{ address }}",
    "heartbeat_timeout_ms": {{ raft_heartbeat_timeout_ms | default(100) }},
    "election_timeout_ms": {{ raft_election_timeout_ms | default(200) }},
    "leader_lease_timeout_ms": {{ raft_leader_lease_timeout_ms | default(80) }},
    "commit_timeout_ms": {{ raft_commit_timeout_ms | default(30) }},
    "propose_queue_size": {{ raft_propose_queue_size | default(1024) }},
    "peers": [
{% for peer in raft_peers | default([{'id': node_id | default(raft_node_id | default(inventory_hostname)), 'address': (ansible_host | default('127.0.0.1')) ~ ':' ~ (raft_port | default(7110)), 'forward_address': (ansible_host | default('127.0.0.1')) ~ ':' ~ (forward_port | default(7210))}]) %}
      {
        "id": "{{ peer.id }}",
        "address": "{{ peer.address }}",
        "forward_address": "{{ peer.forward_address }}"
      }{% if not loop.last %},{% endif %}
{% endfor %}
    ]
  }
{% else %}
  "rust_config_path": "{{ deploy_dir }}/{{ rust_config_path }}"
{% endif %}
}
