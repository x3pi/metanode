[Unit]
Description=MetaNode Execution Service - {{ inventory_hostname }} (Cluster {{ cluster_id }}, ChainID {{ chain_id | default(991) }})
After=network.target network-online.target
Wants=network-online.target

[Service]
EnvironmentFile=-{{ node_data_dir }}/security.env
Type=simple
User={{ ansible_user | default('metanode') }}
WorkingDirectory={{ node_data_dir }}
ExecStart={{ bin_dir }}/simple_chain -config={{ node_data_dir }}/config.json
ExecStop=/bin/kill -SIGTERM $MAINPID
Restart=always
RestartSec=3s
TimeoutStopSec=30
LimitNOFILE=65536
LimitCORE=infinity
Environment="PARENT_CHAIN_URL=http://{{ parent_chain_host | default('127.0.0.1') }}:{{ parent_chain_rpc_port | default(8547) }}"
Environment="PARENT_CHAIN_URLS={{ parent_chain_urls_csv | default('') }}"

StandardOutput=append:{{ base_log_dir }}/{{ inventory_hostname }}.log
StandardError=append:{{ base_log_dir }}/{{ inventory_hostname }}.log
SyslogIdentifier=metanode-{{ inventory_hostname }}

[Install]
WantedBy=multi-user.target
