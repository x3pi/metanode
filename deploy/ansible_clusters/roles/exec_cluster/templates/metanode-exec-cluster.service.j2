[Unit]
Description=MetaNode Execution Service - {{ inventory_hostname }} (Cluster {{ cluster_id }}, ChainID {{ chain_id | default(101) }})
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=simple
User={{ ansible_user | default('metanode') }}
WorkingDirectory={{ node_data_dir }}
ExecStart={{ bin_dir }}/simple_chain -config={{ node_data_dir }}/config.json
ExecStop=/bin/kill -SIGTERM $MAINPID
Restart=always
RestartSec=3s
TimeoutStopSec=30
LimitNOFILE=65536
LimitCORE=infinity

StandardOutput=append:{{ base_log_dir }}/{{ inventory_hostname }}.log
StandardError=append:{{ base_log_dir }}/{{ inventory_hostname }}.log
SyslogIdentifier=metanode-{{ inventory_hostname }}

[Install]
WantedBy=multi-user.target
