[Unit]
Description=MetaNode Execution Service - {{ inventory_hostname }} (Cluster {{ cluster_id }}, ChainID {{ chain_id | default(991) }})
After=network.target network-online.target
Wants=network-online.target
# Stop restarting after repeated crashes (e.g. disk full): a replica that fails closed again and again must
# stay down for the operator instead of crash-looping every few seconds and flooding the log/crash.log.
StartLimitIntervalSec={{ systemd_start_limit_interval_sec | default(600) }}
StartLimitBurst={{ systemd_start_limit_burst | default(5) }}

[Service]
EnvironmentFile=-{{ node_data_dir }}/security.env
Type=simple
User={{ ansible_user | default('abc') }}
WorkingDirectory={{ node_data_dir }}
ExecStart={{ bin_dir }}/simple_chain -config={{ node_data_dir }}/config.json
ExecStop=/bin/kill -SIGTERM $MAINPID
Restart=always
RestartSec=3s
TimeoutStopSec=30
LimitNOFILE=65536
LimitCORE=infinity
LimitMEMLOCK=infinity
{% if systemd_memory_high is defined %}
MemoryHigh={{ systemd_memory_high }}
{% endif %}
{% if systemd_memory_max is defined %}
MemoryMax={{ systemd_memory_max }}
{% endif %}
{% if not (standalone_chain | default(false) | bool) %}
Environment="PARENT_CHAIN_URL={{ parent_chain_url | default('http://' ~ (parent_chain_host | default('127.0.0.1')) ~ ':' ~ (parent_chain_rpc_port | default(8547))) }}"
Environment="PARENT_CHAIN_URLS={{ parent_chain_urls | default(parent_chain_urls_csv | default('')) }}"
Environment="BLS_CONSERVATION_MODE={{ bls_conservation_mode | default('enforce') }}"
Environment="BLS_CONSERVATION_INTERVAL_SECONDS={{ bls_conservation_interval_seconds | default('300') }}"
{% endif %}
Environment="METANODE_ENV={{ metanode_env | default('production') }}"
Environment="NODE_ENV={{ node_env | default('production') }}"

StandardOutput=append:{{ base_log_dir }}/{{ inventory_hostname }}.log
StandardError=append:{{ base_log_dir }}/{{ inventory_hostname }}.log
SyslogIdentifier=metanode-{{ inventory_hostname }}

[Install]
WantedBy=multi-user.target
