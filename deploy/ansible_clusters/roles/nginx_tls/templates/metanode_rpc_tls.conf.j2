# Managed by Ansible (TLS termination for Metanode RPC). Backends stay plain HTTP on localhost/LAN.
{% if tls_reject_unknown_sni | default(true) | bool %}
server {
    listen {{ tls_port | default(443) }} ssl default_server;
    listen [::]:{{ tls_port | default(443) }} ssl default_server;
    ssl_reject_handshake on;
}
{% endif %}

server {
    listen {{ tls_port | default(443) }} ssl http2;
    listen [::]:{{ tls_port | default(443) }} ssl http2;
    server_name {{ tls_domain }};

    ssl_certificate     {{ tls_cert_dest | default('/etc/nginx/tls/fullchain.pem') }};
    ssl_certificate_key {{ tls_key_dest | default('/etc/nginx/tls/privkey.pem') }};
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1h;
    client_max_body_size {{ tls_max_body_size | default('16m') }};

    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_read_timeout {{ tls_proxy_timeout | default('120s') }};
    proxy_send_timeout {{ tls_proxy_timeout | default('120s') }};

    # Primary JSON-RPC / WebSocket endpoint ({{ inventory_hostname }})
    location / { proxy_pass {{ tls_upstream | default('http://127.0.0.1:' ~ (rpc_port | default(8747))) }}; }
{% for loc in (tls_extra_locations | default([])) %}
{% if loc.comment is defined and loc.comment %}
    # {{ loc.comment }}
{% endif %}
    location {{ loc.path }} { proxy_pass {{ loc.upstream }}; }
{% endfor %}
}

