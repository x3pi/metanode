#!/bin/bash
# ╔═══════════════════════════════════════════════════════════════════╗
# ║  MULTI-SERVER DEPLOYMENT CONFIG — TEMPLATE                        ║
# ║                                                                   ║
# ║  HOW TO USE:                                                      ║
# ║    cp deploy.env.template deploy.env                              ║
# ║    # Edit deploy.env with your real values                        ║
# ║    # deploy.env is in .gitignore — NEVER commit real credentials  ║
# ║                                                                   ║
# ║  Flow: Build locally → Push binaries+configs → Start remote       ║
# ╚═══════════════════════════════════════════════════════════════════╝

# ─── SSH Config ──────────────────────────────────────────────────────
SSH_USER="your_unix_username"

# Authentication: "key" (recommended for production) or "password"
SSH_AUTH="key"

# For key auth: SSH key path (leave empty for default ~/.ssh/id_rsa)
SSH_KEY="~/.ssh/id_rsa_metanode"

# For password auth: INSECURE — only use for initial setup, then switch to key
# SSH_PASSWORD="CHANGE_ME"

# SSH options
SSH_OPTS="-o StrictHostKeyChecking=no -o ConnectTimeout=10"

# ─── Server IPs ─────────────────────────────────────────────────────
# Production servers — replace with your actual IPs or hostnames
SERVER_A="10.0.0.1"   # Node 0, Node 1
SERVER_B="10.0.0.2"   # Node 2
SERVER_C="10.0.0.3"   # Node 3, Node 4

# ─── Node → Server Mapping ──────────────────────────────────────────
declare -A NODE_SERVER
NODE_SERVER[0]="$SERVER_A"    # Node 0 runs on Server A
NODE_SERVER[1]="$SERVER_A"    # Node 1 runs on Server A
NODE_SERVER[2]="$SERVER_B"    # Node 2 runs on Server B
NODE_SERVER[3]="$SERVER_C"    # Node 3 runs on Server C
NODE_SERVER[4]="$SERVER_C"    # Node 4 runs on Server C

# ─── Local Source Paths (on the BUILD machine) ──────────────────────
LOCAL_CHAIN_DIR="/home/your_user/nhat/con-chain-v2"
LOCAL_METANODE="${LOCAL_CHAIN_DIR}/metanode/consensus/metanode"
LOCAL_GO_SIMPLE="${LOCAL_CHAIN_DIR}/metanode/execution/cmd/simple_chain"

# ─── Remote Deploy Paths (auto-created on each server) ──────────────
REMOTE_DEPLOY_DIR="/home/${SSH_USER}/nhat/con-chain-v2"
REMOTE_METANODE="${REMOTE_DEPLOY_DIR}/metanode/consensus/metanode"
REMOTE_SCRIPTS="${REMOTE_METANODE}/scripts/node"
REMOTE_GO_SIMPLE="${REMOTE_DEPLOY_DIR}/metanode/execution/cmd/simple_chain"

# ─── Build Config ───────────────────────────────────────────────────
RUST_TOOLCHAIN="stable"
GO_TOOLCHAIN="go1.23.5"
