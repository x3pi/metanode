#!/bin/bash
# ╔═══════════════════════════════════════════════════════════════════╗
# ║  MULTI-SERVER DEPLOYMENT CONFIG — 3 NODES ON 3 MACHINES           ║
# ║                                                                   ║
# ║  Machines:                                                        ║
# ║    192.168.1.234  →  Node 0  (máy chính / build machine)         ║
# ║    192.168.1.233  →  Node 1                                       ║
# ║    192.168.1.231  →  Node 2                                       ║
# ║                                                                   ║
# ║  Usage:                                                           ║
# ║    ENV_FILE=deploy-3nodes.env ./deploy_cluster.sh --all           ║
# ║                                                                   ║
# ║  Flow: Build locally (234) → Push binaries+configs → Start remote ║
# ╚═══════════════════════════════════════════════════════════════════╝

# ─── SSH Config ──────────────────────────────────────────────────────
SSH_USER="abc"

# Authentication: "key" or "password"
SSH_AUTH="password"

# For key auth: SSH key path (leave empty for default ~/.ssh/id_rsa)
SSH_KEY=""

# For password auth: (requires sshpass installed)
SSH_PASSWORD="1234@abcd"

# SSH options
SSH_OPTS="-o StrictHostKeyChecking=no -o ConnectTimeout=10"

# ─── Server IPs ─────────────────────────────────────────────────────
SERVER_A="192.168.1.234"   # Node 0 (máy build + deploy)
SERVER_B="192.168.1.233"   # Node 1
SERVER_C="192.168.1.231"   # Node 2

# ─── Node → Server Mapping ──────────────────────────────────────────
declare -A NODE_SERVER
NODE_SERVER[0]="$SERVER_A"    # Node 0 chạy trên máy 234
NODE_SERVER[1]="$SERVER_B"    # Node 1 chạy trên máy 233
NODE_SERVER[2]="$SERVER_C"    # Node 2 chạy trên máy 231

# Các Node 3 và 4 KHÔNG khai báo để tránh script deploy lên chúng.

# ─── Local Source Paths (existing code on THIS machine: 192.168.1.234) ─────
LOCAL_CHAIN_DIR="/home/abc/nhat/con-chain-v2"
LOCAL_METANODE="${LOCAL_CHAIN_DIR}/metanode/consensus/metanode"
LOCAL_GO_SIMPLE="${LOCAL_CHAIN_DIR}/metanode/execution/cmd/simple_chain"

# ─── Remote Deploy Paths (auto-created on each server) ──────────────
REMOTE_DEPLOY_DIR="/home/${SSH_USER}/nhat/con-chain-v2"
REMOTE_METANODE="${REMOTE_DEPLOY_DIR}/metanode/consensus/metanode"
REMOTE_SCRIPTS="${REMOTE_METANODE}/scripts/node"
REMOTE_GO_SIMPLE="${REMOTE_DEPLOY_DIR}/metanode/execution/cmd/simple_chain"

# ─── Build Config ───────────────────────────────────────────────────
RUST_TOOLCHAIN="nightly"
GO_TOOLCHAIN="go1.23.5"
