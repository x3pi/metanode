#!/bin/bash
# ╔═══════════════════════════════════════════════════════════════════╗
# ║  MULTI-SERVER DEPLOYMENT CONFIG — 3 MACHINES TEST CLUSTER         ║
# ║                                                                   ║
# ║  Machines:                                                        ║
# ║    192.168.1.232  →  Máy chính (build machine / deploy machine)   ║
# ║    192.168.1.233  →  Node 2                                       ║
# ║    192.168.1.231  →  Node 3                                       ║
# ║                                                                   ║
# ║  Usage:                                                           ║
# ║    ENV_FILE=deploy-3machines.env ./deploy_cluster.sh --all        ║
# ║                                                                   ║
# ║  Flow: Build locally (234) → Push binaries+configs → Start remote ║
# ╚═══════════════════════════════════════════════════════════════════╝

# ─── SSH Config ──────────────────────────────────────────────────────
SSH_USER="abc"

# Authentication: "key" or "password"
SSH_AUTH="password"

# For key auth: SSH key path (leave empty for default ~/.ssh/id_rsa)
SSH_KEY=""

# For password auth: (requires sshpass installed)
SSH_PASSWORD="1234@abcd"

# SSH options
SSH_OPTS="-o StrictHostKeyChecking=no -o ConnectTimeout=10"

# ─── Server IPs ─────────────────────────────────────────────────────
SERVER_A="192.168.1.231"   # Node 0, Node 1  (máy build + deploy 2 node)
SERVER_B="192.168.1.233"   # Node 2
SERVER_C="192.168.1.231"   # Node 3

# ─── Node → Server Mapping ──────────────────────────────────────────
declare -A NODE_SERVER
NODE_SERVER[0]="$SERVER_A"    # Node 0 chạy trên máy 234
NODE_SERVER[1]="$SERVER_A"    # Node 1 chạy trên máy 234
NODE_SERVER[2]="$SERVER_B"    # Node 2 chạy trên máy 233
NODE_SERVER[3]="$SERVER_C"    # Các Node 3 KHÔNG khai báo để tránh script deploy lên chúng.
NODE_SERVER[4]="$SERVER_C"    # Node 4 (sync_only) 

# ─── Storage Settings ───────────────────────────────────────────────
# Chỉ định các node cần tạo ổ cứng BTRFS (thường là sync_only node để snapshot)
BTRFS_NODES="4"

# ─── Local Source Paths (dynamically resolved to avoid conflicts) ───
PROJECT_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../../.." && pwd)"

LOCAL_CHAIN_DIR="$(cd "${PROJECT_ROOT}/.." && pwd)"
LOCAL_METANODE="${PROJECT_ROOT}/consensus/metanode"
LOCAL_GO_SIMPLE="${PROJECT_ROOT}/execution/cmd/simple_chain"

# ─── Remote Deploy Paths (auto-created on each server) ──────────────
REMOTE_DEPLOY_DIR="/home/${SSH_USER}/nhat/con-chain-v2"
REMOTE_PROJECT_ROOT="${REMOTE_DEPLOY_DIR}/metanode"
REMOTE_METANODE="${REMOTE_PROJECT_ROOT}/consensus/metanode"
REMOTE_SCRIPTS="${REMOTE_METANODE}/scripts/node"
REMOTE_GO_SIMPLE="${REMOTE_PROJECT_ROOT}/execution/cmd/simple_chain"

# ─── Build Config ───────────────────────────────────────────────────
RUST_TOOLCHAIN="stable"
GO_TOOLCHAIN="go1.23.5"
