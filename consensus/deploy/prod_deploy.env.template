#!/bin/bash
# ╔═══════════════════════════════════════════════════════════════════╗
# ║  PROD DEPLOY CONFIG TEMPLATE                                      ║
# ║                                                                   ║
# ║  Usage:                                                           ║
# ║    cp prod_deploy.env.template prod_deploy.env                    ║
# ║    # Fill in real values in prod_deploy.env                       ║
# ║    ./prod_deploy.sh --all                                         ║
# ║                                                                   ║
# ║  CRITICAL: prod_deploy.env is in .gitignore — NEVER commit it!    ║
# ╚═══════════════════════════════════════════════════════════════════╝

# ─── SSH Authentication ──────────────────────────────────────────────
SSH_USER="abc"

# "key" = SSH key (recommended for production)
# "password" = sshpass (insecure, only for initial setup)
SSH_AUTH="key"

# Path to your SSH private key
SSH_KEY="$HOME/.ssh/id_ed25519_metanode"

# If using password auth (NOT recommended):
# SSH_PASSWORD="CHANGE_ME_DO_NOT_COMMIT"

# SSH options
SSH_OPTS="-o StrictHostKeyChecking=no -o ConnectTimeout=15 -o ServerAliveInterval=30"

# ─── Server IP Addresses ─────────────────────────────────────────────
# Replace with your actual server IPs or hostnames

# Server A: runs Node 0 and Node 1 (also the build machine)
SERVER_A="192.168.1.234"

# Server B: runs Node 2
SERVER_B="192.168.1.233"

# Server C: runs Node 3 and Node 4
SERVER_C="192.168.1.231"

# ─── Node → Server Mapping ───────────────────────────────────────────
declare -A NODE_SERVER
NODE_SERVER[0]="$SERVER_A"
NODE_SERVER[1]="$SERVER_A"
NODE_SERVER[2]="$SERVER_B"
NODE_SERVER[3]="$SERVER_C"
NODE_SERVER[4]="$SERVER_C"

# ─── RPC Ports (must match config-master-nodeN.json) ─────────────────
declare -A NODE_RPC_PORT
NODE_RPC_PORT[0]=8757
NODE_RPC_PORT[1]=10747
NODE_RPC_PORT[2]=10749
NODE_RPC_PORT[3]=10750
NODE_RPC_PORT[4]=10748

# ─── Paths ───────────────────────────────────────────────────────────
# Local paths on the BUILD machine (Server A)
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
LOCAL_METANODE_ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"
LOCAL_GO_SIMPLE="$LOCAL_METANODE_ROOT/execution/cmd/simple_chain"
LOCAL_RUST_DIR="$LOCAL_METANODE_ROOT/consensus/metanode"
LOCAL_SCRIPTS="$LOCAL_RUST_DIR/scripts"

# Remote paths on each server (will be auto-created)
REMOTE_BASE_DIR="/home/${SSH_USER}/nhat/con-chain-v2/metanode"
REMOTE_GO_SIMPLE="$REMOTE_BASE_DIR/execution/cmd/simple_chain"
REMOTE_RUST_DIR="$REMOTE_BASE_DIR/consensus/metanode"
REMOTE_SCRIPTS="$REMOTE_RUST_DIR/scripts"

# Key storage directory on remote servers
REMOTE_KEY_DIR="/opt/metanode/keys"

# ─── Build Config ────────────────────────────────────────────────────
RUST_TOOLCHAIN="stable"
GO_TOOLCHAIN="go1.23.5"

# ─── Monitoring (Telegram) ───────────────────────────────────────────
# Leave empty to disable Telegram alerts
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# ─── Snapshot HTTP Server ────────────────────────────────────────────
# Port range for snapshot HTTP servers (one per node)
SNAPSHOT_PORT_BASE=8600   # Node N uses port 8600+N
