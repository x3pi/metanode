#!/bin/bash
# ╔═══════════════════════════════════════════════════════════════════╗
# ║  LOCAL TEST CONFIG — Chạy tất cả trên máy local (1 máy, 5 nodes) ║
# ║                                                                   ║
# ║  Dùng khi bạn chưa có nhiều server hoặc muốn test trước.         ║
# ║  Tất cả SERVER_A/B/C đều trỏ về localhost.                       ║
# ║                                                                   ║
# ║  Usage:                                                           ║
# ║    ENV_FILE=local_test.env ./prod_deploy.sh --status              ║
# ║    ENV_FILE=local_test.env ./prod_deploy.sh --start               ║
# ║    ./local_test.sh                   # Full local test suite      ║
# ╚═══════════════════════════════════════════════════════════════════╝

# ─── SSH Auth — dùng localhost, không cần SSH ────────────────────────
SSH_USER="$(whoami)"
SSH_AUTH="key"
SSH_KEY="$HOME/.ssh/id_rsa"  # Có thể không dùng vì ta override SSH functions

# ─── Tất cả nodes đều chạy trên localhost ────────────────────────────
SERVER_A="127.0.0.1"
SERVER_B="127.0.0.1"
SERVER_C="127.0.0.1"

# ─── Node → Server Mapping (all local) ───────────────────────────────
declare -A NODE_SERVER
NODE_SERVER[0]="127.0.0.1"
NODE_SERVER[1]="127.0.0.1"
NODE_SERVER[2]="127.0.0.1"
NODE_SERVER[3]="127.0.0.1"
NODE_SERVER[4]="127.0.0.1"

# ─── RPC Ports ───────────────────────────────────────────────────────
declare -A NODE_RPC_PORT
NODE_RPC_PORT[0]=8757
NODE_RPC_PORT[1]=10747
NODE_RPC_PORT[2]=10749
NODE_RPC_PORT[3]=10750
NODE_RPC_PORT[4]=10748

# ─── Paths (same machine, no remote) ────────────────────────────────
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
LOCAL_METANODE_ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"
LOCAL_GO_SIMPLE="$LOCAL_METANODE_ROOT/execution/cmd/simple_chain"
LOCAL_RUST_DIR="$LOCAL_METANODE_ROOT/consensus/metanode"
LOCAL_SCRIPTS="$LOCAL_RUST_DIR/scripts"

# Remote = same as local (single machine)
REMOTE_BASE_DIR="$LOCAL_METANODE_ROOT"
REMOTE_GO_SIMPLE="$LOCAL_GO_SIMPLE"
REMOTE_RUST_DIR="$LOCAL_RUST_DIR"
REMOTE_SCRIPTS="$LOCAL_SCRIPTS"

# ─── Monitoring (Telegram optional) ─────────────────────────────────
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# ─── Snapshot ────────────────────────────────────────────────────────
SNAPSHOT_PORT_BASE=8600
